# Copia este archivo a .env para desarrollo local.
# Genera secrets reales con: bash scripts/generate-local-secrets.sh
# NUNCA subas tu .env real a git.

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_NAME=CopilotoIA Core
API_HOST=0.0.0.0
API_PORT=8000
# Nivel de log: DEBUG para desarrollo, INFO para producción
LOG_LEVEL=INFO

# ── Base de datos (PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://copiloto_app:change-me-app-password@postgres:5432/copilotoia
DATABASE_ADMIN_URL=postgresql://copiloto_admin:change-me-admin-password@postgres:5432/copilotoia
POSTGRES_DB=copilotoia
POSTGRES_USER=copiloto_admin
POSTGRES_PASSWORD=change-me-admin-password
APP_DB_USER=copiloto_app
APP_DB_PASSWORD=change-me-app-password

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Autenticación JWT ──────────────────────────────────────────────────────────
JWT_ISSUER=copilotoia-local
JWT_AUDIENCE=copilotoia-panel
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=change-me-super-long-jwt-secret-min-32-chars

# Auth0/OIDC se carga desde .env.auth0.local, generado por scripts/configure-auth0.sh.
# No dupliques aquí AUTH0_DOMAIN, AUTH0_AUDIENCE ni AUTH0_CLAIMS_NAMESPACE.

# Token interno para comunicación entre servicios (mínimo 32 caracteres)
SERVICE_TOKEN=change-me-internal-service-token-min-32-chars

# ── WhatsApp / Meta ────────────────────────────────────────────────────────────
# Solo la versión de la API Graph es global. Las credenciales de WhatsApp
# (META_ACCESS_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN) se configuran
# por tenant desde el panel de administración (Admin → Canales) y se almacenan
# en la tabla app.channels — NO van aquí como variables de entorno.
META_GRAPH_VERSION=v23.0

# ── Almacenamiento S3 / MinIO ──────────────────────────────────────────────────
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=copilotoia-local
S3_ACCESS_KEY_ID=copilotoia-minio
S3_SECRET_ACCESS_KEY=change-me-minio-password

# ── Base de conocimiento ───────────────────────────────────────────────────────
# Backend de archivos: local (dev/piloto) | s3 (MinIO o S3 en producción)
KNOWLEDGE_STORAGE_BACKEND=local
KNOWLEDGE_STORAGE_LOCAL_PATH=/app/data/knowledge
KNOWLEDGE_STORAGE_S3_BUCKET=copilotoia-local
KNOWLEDGE_FILE_MAX_BYTES=10485760
KNOWLEDGE_ALLOWED_MIME_TYPES=text/plain,text/markdown,text/csv,application/json,application/pdf

# ── RAG / Embeddings ───────────────────────────────────────────────────────────
# Proveedor: local_hash (sin API, desarrollo) | openai | anthropic | ollama
RAG_EMBEDDING_PROVIDER=local_hash
# Modelo según proveedor:
#   openai     → text-embedding-3-small (1536 dims) | text-embedding-3-large (3072 dims)
#   anthropic  → voyage-3-lite (1024 dims) | voyage-3 (1024 dims)
#   ollama     → nomic-embed-text (768 dims) u otro modelo local
#   local_hash → copilotoia-local-hash-v1 (1536 dims, sin API)
RAG_EMBEDDING_MODEL=copilotoia-local-hash-v1
RAG_EMBEDDING_DIMENSIONS=1536
# API key del proveedor de embeddings real. Dejar vacío para local_hash.
#RAG_EMBEDDING_API_KEY=sk-...
RAG_CHUNK_MAX_TOKENS=500
RAG_CHUNK_OVERLAP_TOKENS=80

# ── Motor de respuesta ─────────────────────────────────────────────────────────
# template  → solo respuestas de plantilla (sin LLM)
# local_llm → siempre usa Ollama
# cascade   → template → LLM local → cloud LLM (si configurado) → handoff (recomendado)
# cloud_llm → usa directamente el LLM cloud (Claude / OpenAI)
ANSWER_ENGINE=cascade

# Umbrales del modo cascade (ajustar según tasa de handoffs en logs)
CASCADE_TEMPLATE_MIN_SCORE=0.55
CASCADE_LLM_MIN_SCORE=0.12

# ── LLM local via Ollama ───────────────────────────────────────────────────────
# Ollama corre FUERA del compose, en el host o servidor con GPU.
# Mac / Windows con Docker Desktop:  http://host.docker.internal:11434
# Linux sin host.docker.internal:    http://172.17.0.1:11434
# Servidor externo con GPU:          http://<ip-servidor>:11434
# Instalar: https://ollama.com/download
# Luego:    ollama pull llama3.2:3b && ollama serve
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_TIMEOUT_SECONDS=30

# ── LLM cloud (Claude API / OpenAI) ───────────────────────────────────────────
# En cascade: tier-3 automático cuando Ollama no está disponible.
# Como motor primario: ANSWER_ENGINE=cloud_llm
# CLOUD_LLM_PROVIDER: 'claude' | 'openai'
# CLOUD_LLM_MODEL: modelo a usar (default claude-sonnet-4-6 / gpt-4o)
# CLOUD_LLM_API_KEY: API key del proveedor (secreto — no commitear)
# CLOUD_LLM_TIMEOUT_SECONDS: timeout de la llamada HTTP (default 30)
#CLOUD_LLM_PROVIDER=claude
#CLOUD_LLM_MODEL=claude-sonnet-4-6
#CLOUD_LLM_API_KEY=sk-ant-...
#CLOUD_LLM_TIMEOUT_SECONDS=30

# ── Re-engagement automático ───────────────────────────────────────────────────
# Si un handoff lleva este tiempo sin que un agente lo atienda,
# el bot retoma la conversación automáticamente. 0 = desactivado.
BOT_REOPEN_AFTER_HOURS=2

# ── Rate limiting + circuit breaker (TASK-0059) ───────────────────────────────
# RATE_LIMIT_PER_MIN: requests/min por IP (más tenant_id si viene en el path).
# RATE_LIMIT_WEBHOOK_PER_MIN: cap más permisivo para /webhooks/whatsapp/*
# para no bloquear los retries legítimos de Meta.
# CIRCUIT_BREAKER_FAILURE_THRESHOLD: fallos consecutivos antes de abrir.
# CIRCUIT_BREAKER_COOLDOWN_SECONDS: tiempo en open antes de probar half_open.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_WEBHOOK_PER_MIN=600
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ── Observabilidad (OpenTelemetry) ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
