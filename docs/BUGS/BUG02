):
    tenant_id = await tenant_id_from_request(request, conn)
    update_data = payload.model_dump(exclude_unset=True)
    if not update_data:
        row = await conn.fetchrow(
            'select * from app.contact_packages where tenant_id=$1 and contact_id=$2 and id=$3',
            tenant_id,
            contact_id,
            contact_package_id,
